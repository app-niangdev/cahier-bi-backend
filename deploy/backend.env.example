# DÉSACTIVÉ : configuration héritée de SN Devis, mise en commentaire lors du passage à Cahier Bi.
# À réécrire pour le déploiement de Cahier Bi avant de le réactiver.
#
# # /opt/devis/backend/.env : variables du conteneur backend
# APP_NAME="Devis"
# APP_ENV=production
# # docker run --rm --entrypoint php ghcr.io/app-niangdev/devis-backend:latest artisan key:generate --show
# APP_KEY=
# APP_DEBUG=false
# APP_URL=https://backenddevis.niangdev.com
# FRONTEND_URL=https://devis.niangdev.com
#
# APP_LOCALE=fr
# APP_FALLBACK_LOCALE=fr
# APP_FAKER_LOCALE=fr_FR
#
# # openssl rand -hex 32
# APP_JWT_SECRET=
# JWT_ACCESS_TTL=3600
# JWT_REFRESH_TTL=2592000
#
# # * : toutes origines (JWT sans cookies). L'application Android n'est pas concernée par CORS ;
# # ajouter l'adresse de la PWA si elle est déployée.
# CORS_ALLOWED_ORIGINS=https://devis.niangdev.com
#
# BCRYPT_ROUNDS=12
#
# # Logs vers la sortie du conteneur : docker compose logs backend
# LOG_CHANNEL=stderr
# LOG_LEVEL=warning
#
# # PostgreSQL partagé sur infrastructure_net : DB_HOST = nom du conteneur postgres sur ce réseau
# DB_CONNECTION=pgsql
# DB_HOST=postgres
# DB_PORT=5432
# DB_DATABASE=devis
# DB_USERNAME=devis
# DB_PASSWORD=
#
# SESSION_DRIVER=database
# CACHE_STORE=database
# QUEUE_CONNECTION=database
# FILESYSTEM_DISK=local
#
# MAIL_MAILER=log
# MAIL_FROM_ADDRESS="no-reply@niangdev.com"
# MAIL_FROM_NAME="Devis"
#
# SUBSCRIPTION_WARNING_DAYS=5
# SUBSCRIPTION_TRIAL_DAYS=30
# SUBSCRIPTION_CURRENCY=XOF
# # Contact affiché aux gestionnaires pour renouveler (numéros à 9 chiffres)
# SUBSCRIPTION_CONTACT_NAME="Administrateur Devis"
# SUBSCRIPTION_CONTACT_PHONE=
# SUBSCRIPTION_CONTACT_WHATSAPP=
# SUBSCRIPTION_PAYMENT_METHODS="Wave, Orange Money"
#
# # Codes OTP WhatsApp (1re connexion, mot de passe oublié)
# WAHA_BASE_URL=https://waha.niangdev.com
# WAHA_API_KEY=
# WAHA_SESSION=devis
# WAHA_TIMEOUT=20
#
# OTP_TTL=300
# OTP_MAX_ATTEMPTS=5
# OTP_RESEND_COOLDOWN=60
# OTP_MAX_RESEND=3
# OTP_RESET_TTL=600
#
# # Application mobile Android (APK). Nouvelle version publiée : monter MOBILE_LATEST_VERSION,
# # puis « docker compose up -d backend » (configuration figée au démarrage).
# # MOBILE_MIN_VERSION : seulement pour imposer la mise à jour (ancienne version incompatible).
# MOBILE_LATEST_VERSION=1.0.0
# MOBILE_MIN_VERSION=1.0.0
# MOBILE_ANDROID_URL=https://app-devis.niangdev.com/devis.apk
# MOBILE_RELEASE_NOTES=
